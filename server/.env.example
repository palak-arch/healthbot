# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=healthbot

# Server
PORT=3001

# Gemini API Key (server-side only — NOT exposed to browser)
GEMINI_API_KEY=your_gemini_api_key

# Patient auth: required in production, 32+ random characters (openssl rand -base64 48)
PATIENT_JWT_SECRET=

# Optional: move vaccination records and patient profiles to Firestore.
# Unset = MySQL. Set = Firestore. Never commit a real key.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
